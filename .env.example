# ── REQUIRED NOW ──────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Used for: GPT-4o (script segmentation) + TTS (voiceover)
OPENAI_API_KEY=your_openai_api_key_here
# ── LLM brain provider (optional) ─────────────────────────────
# The reasoning/vision/fast brain (agents/llm.py) runs on one of:
#   LLM_PROVIDER = openai (default) | anthropic | bedrock | gemini
# For provider=anthropic — direct Anthropic API (Claude), independent of AWS
# Bedrock/Marketplace. Get a key at https://console.anthropic.com/ :
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Per-tier model override (else config/llm.json defaults apply):
#   LLM_REASONING_MODEL / LLM_VISION_MODEL / LLM_FAST_MODEL
# ── Identity model (reference-conditioned generation, config/models.json) ─────
# Which model keeps a supplied face/character across a new scene. Default is
# Nano Banana (fal) → gpt-image-1 fallback. Override the primary with:
#   IDENTITY_MODEL = nano_banana_edit | flux_kontext | gpt_image_edit
# ── Music engine (optional seam, config/music.json) ───────────
# provider = suno (default) | lyria. Override the config default with:
#   MUSIC_PROVIDER = lyria
#   lyria → Google Lyria 3 via the Gemini API (reuses GEMINI_API_KEY); vocal
#           songs + instrumental, cleaner commercial licensing + SynthID.
#           Needs Lyria quota/billing enabled on the Gemini project.
#   suno  → Suno wrapper API (SUNO_API_KEY).
# ── Voice / TTS ───────────────────────────────────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
# Used for: ALL voice-over + lip-sync audio (agents/tts_generator.py). NOT optional
# in practice — a narrated reel has no voice without it.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Global default voice. UNSET = lip-sync silently skips every frame that has no
# per-speaker voice assigned (agents/lipsync_coordinator.py). Per-language + per-role
# voices live in config/voices.json; per-character voices are set on the Canvas
# character sheet and win over both.
# ELEVENLABS_VOICE_ID=your_default_voice_id_here

# ── PAID GENERATION VENDORS — the app quotes these in the 💰 estimate ──────────
# Every key below is read by agents/*; a MISSING key does not crash a render — the
# step degrades and (post-2026-07-17) reports to the degradation ledger. Check live
# state any time with:  python -m agents.balances
#
# fal.ai — ONE key, ~11 models: flux/seedream/nano_banana/nano_banana_edit/
# flux_kontext (images), seedance/veo/hailuo (video), aura_sr/clarity (upscale),
# mmaudio (SFX). There is NO separate "Veo credit" — Veo is billed through fal.
# Top up: fal.ai/dashboard/billing
FAL_API_KEY=your_fal_api_key_here
# Kling (klingai.com → Account) — kling_std/kling_pro. 100% of the DRAFT tier, so
# every iteration render spends Kling. Prepaid "resource packs" EXPIRE (validity
# window, not just balance) — an expired pack strands its unused units and silently
# drops you to pay-as-you-go. `python -m agents.balances` now surfaces this.
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here
# Higgsfield (cloud.higgsfield.ai → Billing) — prompt-driven DoP video. Leads the
# landscape/hero lanes. HF_API_KEY/HF_API_SECRET are accepted as aliases.
HIGGSFIELD_KEY_ID=your_higgsfield_key_id_here
HIGGSFIELD_KEY_SECRET=your_higgsfield_key_secret_here
# Gemini — the gemini LLM provider AND Google Lyria music (config/music.json).
# Lyria additionally needs BILLING + Lyria quota enabled on the Google Cloud project;
# without it the Lyria models return HTTP 429 "not enough quota" and music falls back.
GEMINI_API_KEY=your_gemini_api_key_here
# Suno (api.sunoapi.org) — music, when config/music.json provider=suno.
SUNO_API_KEY=your_suno_api_key_here

# ── LIP-SYNC (optional, but the UI QUOTES it either way) ──────────────────────
# WITHOUT these the lip-sync cost line still renders in the UI and the operator can
# still tick the box — the coordinator then skips every frame and (since 2026-07-17)
# raises an `alert` on the degradation ledger. Leave unset ONLY if you accept that.
#   HEDRA_API_KEY    — image lip-sync (hedra.com)
#   SYNCLABS_API_KEY — video lip-sync (sync.so)
# HEDRA_API_KEY=your_hedra_api_key_here
# SYNCLABS_API_KEY=your_synclabs_api_key_here

# ── FUTURE: Phase 3 — AI Enhancement Models ───────────────────
# Get from: https://huggingface.co/settings/tokens
# Used for: Real-ESRGAN, Stable Video Diffusion (gated models)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── Cache backend (paid clips, lip-sync clips/audio) ──────────
# Local filesystem by default — no config needed for a single machine.
# Set a persistent volume via HOB_CACHE_DIR, OR use S3 so paid artifacts
# survive container redeploys and are shared across instances.
#   HOB_CACHE_BACKEND = fs (default) | s3
#   HOB_CACHE_DIR     = local cache root (default: ~/.hob_cache)
# For s3 (uses the standard AWS credential chain / IAM role):
#   HOB_CACHE_S3_BUCKET = your-hob-cache-bucket
#   HOB_CACHE_S3_PREFIX = hob_cache
HOB_CACHE_BACKEND=fs
# HOB_CACHE_DIR=/var/hob_cache
# HOB_CACHE_S3_BUCKET=
# HOB_CACHE_S3_PREFIX=hob_cache

# ── Web UI: server folder browsing / typed asset paths ─────────
# Typed asset paths, the 🗂 Server folder browser, and /media thumbnails are
# confined to this directory (plus the runs dir). On hosted deploys point it
# at the directory that holds user asset folders. Default: the home directory.
# ASSETS_BROWSE_ROOT=/srv/hob/assets

# ── Content Credentials (C2PA) — sign finished reels with their provenance ─────
# Unset → a self-signed dev chain is generated (credential structurally Valid but
# untrusted issuer). Production: point at a C2PA-trust-list cert chain (leaf+CA
# PEM) and its PKCS#8 private key. HOB_C2PA_TSA = RFC-3161 timestamp authorities
# tried in order (signing makes one outbound call). HOB_C2PA_DISABLED=1 skips.
# HOB_C2PA_CERT=/secrets/c2pa_chain.pem
# HOB_C2PA_KEY=/secrets/c2pa_key_pk8.pem
# HOB_C2PA_TSA=http://timestamp.digicert.com,http://timestamp.sectigo.com
# HOB_C2PA_DISABLED=0
# HOB_SCHEMA_STRICT=1 makes a provenance-schema violation raise instead of warn
# (tests/dev only — prod warns via the degradation ledger and still ships).
# HOB_SCHEMA_STRICT=0

# ── Storage ───────────────────────────────────────────────────────────────────
# Where every story's media + the run DB live. Both DEFAULT to ~/.hob_runs and must
# stay on the same, DURABLE filesystem. They used to default into tempfile.gettempdir(),
# which silently follows TMPDIR — on a box whose TMPDIR pointed at an external volume
# that put the whole archive on removable storage, inside a directory the OS is free to
# erase, and gave SQLite hard "disk I/O error"s. Set these explicitly on any deploy.
# HOB_RUNS_DIR=/srv/hob/runs
# HOB_RUNS_DB=/srv/hob/runs/hob_runs.db
