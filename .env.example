# ── REQUIRED ──────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Used for: GPT-4o (segmentation) + Whisper (word captions)
OPENAI_API_KEY=your_openai_api_key_here

# ── VOICE — ElevenLabs (production quality TTS) ───────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
# Used for: Emotional, natural voiceover (replaces OpenAI TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── MEDIA MATCHING — Gemini Vision ────────────────────────────
# Get from: https://aistudio.google.com → "Get API key" (free)
# Used for: AI picks the right image for each script segment
GEMINI_API_KEY=your_gemini_api_key_here

# ── IMAGE-TO-VIDEO — Kling AI ─────────────────────────────────
# Get from: https://klingai.com → Developer → API Keys
# Used for: Realistic AI motion from still photos (replaces Ken Burns)
KLING_API_KEY=your_kling_api_key_here

# ── ENHANCEMENT MODELS (future) ───────────────────────────────
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here
