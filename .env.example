# ── REQUIRED NOW ──────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Used for: GPT-4o (script segmentation) + TTS (voiceover)
OPENAI_API_KEY=your_openai_api_key_here
# ── FUTURE: Phase 2 — Enhanced TTS (optional upgrade) ─────────
# Get from: https://elevenlabs.io/app/settings/api-keys
# Used for: Higher quality voice cloning per brand
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── FUTURE: Phase 3 — AI Enhancement Models ───────────────────
# Get from: https://huggingface.co/settings/tokens
# Used for: Real-ESRGAN, Stable Video Diffusion (gated models)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── Cache backend (paid clips, lip-sync clips/audio) ──────────
# Local filesystem by default — no config needed for a single machine.
# Set a persistent volume via HOB_CACHE_DIR, OR use S3 so paid artifacts
# survive container redeploys and are shared across instances.
#   HOB_CACHE_BACKEND = fs (default) | s3
#   HOB_CACHE_DIR     = local cache root (default: ~/.hob_cache)
# For s3 (uses the standard AWS credential chain / IAM role):
#   HOB_CACHE_S3_BUCKET = your-hob-cache-bucket
#   HOB_CACHE_S3_PREFIX = hob_cache
HOB_CACHE_BACKEND=fs
# HOB_CACHE_DIR=/var/hob_cache
# HOB_CACHE_S3_BUCKET=
# HOB_CACHE_S3_PREFIX=hob_cache
