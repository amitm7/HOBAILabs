{
  "_note": "Model capability catalog + per-shot routing policy. Keep model FACTS here, costs in pricing.json. The router (agents/model_router.py) reads 'routing'; clip_builder/image_generator read 'models' to dispatch a backend. Add a model by adding an entry under 'models' and listing its id in 'routing'.",
  "_updated": "2026-06-07",
  "_fal_endpoints_warning": "fal.ai endpoint slugs and pricing shift monthly — VERIFY each fal_endpoint on fal.ai before the first paid run.",

  "models": {
    "flux": {
      "kind": "image", "backend": "flux", "tier": "premium",
      "strengths": ["face", "portrait", "object"],
      "max_concurrent": 4, "pricing_key": "image_gen.flux_portrait_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "gpt_image": {
      "kind": "image", "backend": "openai", "tier": "standard",
      "strengths": ["object", "symbolic", "text-in-image"],
      "max_concurrent": 4, "pricing_key": "image_gen.openai_gpt_image_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "seedream": {
      "kind": "image", "backend": "fal", "fal_endpoint": "fal-ai/bytedance/seedream/v4/text-to-image",
      "tier": "draft",
      "strengths": ["face", "object", "cheap-test"],
      "max_concurrent": 8, "pricing_key": "image_gen.seedream_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "nano_banana": {
      "kind": "image", "backend": "fal", "fal_endpoint": "fal-ai/nano-banana",
      "tier": "premium",
      "strengths": ["face", "portrait", "photoreal"],
      "max_concurrent": 4, "pricing_key": "image_gen.nano_banana_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },

    "kling_std": {
      "kind": "video", "backend": "kling", "kling_mode": "std", "tier": "draft",
      "strengths": ["face", "motion", "value", "start-frame"],
      "max_concurrent": 5, "pricing_key": "kling.standard_5s_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "kling_pro": {
      "kind": "video", "backend": "kling", "kling_mode": "pro", "tier": "premium",
      "strengths": ["face", "motion", "cinematic", "start-frame"],
      "max_concurrent": 5, "pricing_key": "kling.pro_5s_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "higgsfield": {
      "kind": "video", "backend": "higgsfield", "tier": "premium",
      "strengths": ["camera-move", "cinematic"],
      "max_concurrent": 4, "pricing_key": "higgsfield.generation_5s_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "seedance": {
      "kind": "video", "backend": "fal", "fal_endpoint": "fal-ai/bytedance/seedance/v1/pro/image-to-video",
      "tier": "premium",
      "strengths": ["cinematic", "multi-shot", "motion", "audio"],
      "max_concurrent": 4, "pricing_key": "seedance.generation_5s_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "veo": {
      "kind": "video", "backend": "fal", "fal_endpoint": "fal-ai/veo3/image-to-video",
      "tier": "premium",
      "strengths": ["cinematic", "audio", "dialogue", "lipsync"],
      "max_concurrent": 2, "pricing_key": "veo.generation_5s_usd",
      "aspect": ["9:16", "16:9"]
    },
    "hailuo": {
      "kind": "video", "backend": "fal", "fal_endpoint": "fal-ai/minimax/hailuo-02/standard/image-to-video",
      "tier": "premium",
      "strengths": ["landscape", "motion-physics", "wide"],
      "max_concurrent": 4, "pricing_key": "hailuo.generation_5s_usd",
      "aspect": ["9:16", "16:9", "1:1"]
    },
    "aura_sr": {
      "kind": "upscale", "backend": "fal", "fal_endpoint": "fal-ai/aura-sr",
      "tier": "premium", "upscale_mode": "faithful",
      "strengths": ["faithful", "real-footage", "no-hallucination"],
      "max_concurrent": 4, "pricing_key": "upscale.aura_sr_usd",
      "_use": "REAL person/footage — does NOT invent detail, so a real face stays the real face (moat-safe)."
    },
    "clarity_upscaler": {
      "kind": "upscale", "backend": "fal", "fal_endpoint": "fal-ai/clarity-upscaler",
      "tier": "premium", "upscale_mode": "creative",
      "strengths": ["creative", "ai-stills", "detail-add"],
      "max_concurrent": 4, "pricing_key": "upscale.clarity_usd",
      "_use": "AI stills / ambient B-roll — adds detail (hallucinates), NEVER route a real person here."
    },
    "nano_banana_edit": {
      "kind": "edit", "backend": "fal", "fal_endpoint": "fal-ai/nano-banana/edit",
      "tier": "premium", "ref_input": "image_urls",
      "strengths": ["face", "identity", "reference", "same-character-new-scene"],
      "max_concurrent": 4, "pricing_key": "image_gen.nano_banana_usd",
      "_use": "Reference-conditioned generation — keeps a supplied face/character across a NEW scene. The strong identity path (real face-refs AND fiction characters). VERIFY the fal endpoint before a big run."
    },
    "flux_kontext": {
      "kind": "edit", "backend": "fal", "fal_endpoint": "fal-ai/flux-pro/kontext",
      "tier": "premium", "ref_input": "image_url",
      "strengths": ["identity", "in-context-edit", "consistency"],
      "max_concurrent": 4, "pricing_key": "image_gen.flux_portrait_usd",
      "_use": "In-context edit — holds a subject across scenes. Alternative identity model to nano_banana."
    },
    "gpt_image_edit": {
      "kind": "edit", "backend": "openai",
      "tier": "standard", "strengths": ["edit", "text-in-image"],
      "max_concurrent": 4, "pricing_key": "image_gen.openai_edit_usd",
      "_use": "OpenAI gpt-image-1 edit — the original identity/edit path, now the FALLBACK."
    }
  },

  "routing": {
    "_note": "shot_type → cost_tier → ordered preference list of model ids. Router picks the first id that exists in 'models'. 'real' (real photo/video at the video step) and 'passthrough' (real media at the image step) are handled in the router code.",
    "image": {
      "face":   { "draft": ["seedream"], "premium": ["nano_banana", "flux"] },
      "object": { "draft": ["seedream"], "premium": ["flux", "nano_banana"] }
    },
    "video": {
      "real":      { "draft": ["kling_std"], "premium": ["kling_pro", "seedance"] },
      "face":      { "draft": ["kling_std"], "premium": ["kling_pro", "seedance"] },
      "landscape": { "draft": ["kling_std"], "premium": ["hailuo", "seedance"] },
      "hero":      { "draft": ["kling_std"], "premium": ["seedance", "veo"] },
      "dialogue":  { "draft": ["kling_std"], "premium": ["veo", "kling_pro"] }
    },
    "identity": {
      "_note": "Reference-conditioned generation (keep a supplied face/character in a new scene). Ordered failover — the edit path (agents/image_editor.edit_image) tries these in order. Override the primary with env IDENTITY_MODEL.",
      "default": ["nano_banana_edit", "gpt_image_edit"]
    }
  },

  "fallbacks": {
    "_note": "Gap #8 — per-model ordered alternates for vendor failover. Each chain prefers a DIFFERENT backend first so one vendor outage/price-spike degrades independently. The router (model_router.run_with_fallback) tries the primary, then these in order. Same kind only.",
    "flux":        ["nano_banana", "gpt_image", "seedream"],
    "gpt_image":   ["flux", "nano_banana", "seedream"],
    "seedream":    ["flux", "gpt_image", "nano_banana"],
    "nano_banana": ["flux", "gpt_image", "seedream"],

    "kling_std":   ["hailuo", "seedance", "kling_pro"],
    "kling_pro":   ["seedance", "veo", "kling_std"],
    "higgsfield":  ["kling_std", "seedance", "hailuo"],
    "seedance":    ["kling_std", "hailuo", "veo"],
    "veo":         ["kling_pro", "seedance", "kling_std"],
    "hailuo":      ["kling_std", "seedance", "kling_pro"]
  },

  "defaults": {
    "image": "flux",
    "video": "kling_std"
  }
}
